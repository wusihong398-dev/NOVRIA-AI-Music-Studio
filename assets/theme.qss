
* {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 13px;
}
QMainWindow, QWidget {
    background: #070C18;
    color: #EAF0FF;
}
QToolTip {
    color: #F7F9FF;
    background: #151D31;
    border: 1px solid #394562;
    padding: 6px 8px;
    border-radius: 6px;
}
QListWidget#NavList {
    background: #0A1120;
    border: 1px solid #1B2740;
    border-radius: 14px;
    padding: 8px;
    outline: none;
}
QListWidget#NavList::item {
    color: #B9C5DC;
    padding: 12px 10px;
    margin: 3px 0;
    border-radius: 9px;
}
QListWidget#NavList::item:hover {
    color: #FFFFFF;
    background: #111B31;
}
QListWidget#NavList::item:selected {
    color: #FFFFFF;
    background: #2A2155;
    border: 1px solid #6D4BDF;
}
QLabel#BrandTitle {
    font-size: 19px;
    font-weight: 800;
    color: #FFFFFF;
}
QLabel#BrandSub {
    font-size: 11px;
    color: #8E9AB3;
}
QLabel#PageTitle {
    font-size: 24px;
    font-weight: 800;
    color: #F8FAFF;
}
QLabel#SectionHint {
    color: #91A0BD;
}
QLabel#StatusGood {
    color: #43E0A5;
    font-weight: 700;
}
QGroupBox {
    background: #0C1424;
    border: 1px solid #1E2B45;
    border-radius: 12px;
    margin-top: 14px;
    padding: 14px 12px 12px 12px;
    font-weight: 700;
    color: #DDE6FA;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #C6D1E9;
}
QPushButton {
    min-height: 32px;
    color: #EDF2FF;
    background: #152038;
    border: 1px solid #2A3855;
    border-radius: 8px;
    padding: 7px 13px;
    font-weight: 600;
}
QPushButton:hover {
    background: #1B2947;
    border-color: #56688F;
}
QPushButton:pressed {
    background: #10192D;
}
QPushButton:disabled {
    color: #66718A;
    background: #0D1423;
    border-color: #192238;
}
QPushButton[accent="primary"] {
    background: #5A36D6;
    border: 1px solid #8A6EFF;
    color: white;
}
QPushButton[accent="primary"]:hover { background: #6941E8; }
QPushButton[accent="success"] {
    background: #087A55;
    border: 1px solid #20C997;
}
QPushButton[accent="danger"] {
    background: #8A2630;
    border: 1px solid #E05A67;
}
QPushButton[accent="gold"] {
    background: #6B4A15;
    border: 1px solid #D49A36;
}
QProgressBar {
    min-height: 18px;
    max-height: 18px;
    border: 1px solid #263653;
    border-radius: 9px;
    background: #0B1220;
    text-align: center;
    color: #D9E4F8;
    font-size: 11px;
}
QProgressBar::chunk {
    border-radius: 8px;
    background: #6647E8;
}
QSlider::groove:horizontal {
    height: 6px;
    background: #26334B;
    border-radius: 3px;
}
QSlider::sub-page:horizontal {
    background: #7254F5;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    width: 16px;
    margin: -5px 0;
    background: #A993FF;
    border: 2px solid #D8CEFF;
    border-radius: 8px;
}
QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit {
    min-height: 30px;
    background: #10192C;
    border: 1px solid #293957;
    border-radius: 7px;
    padding: 3px 8px;
    color: #EAF0FF;
}
QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QLineEdit:hover {
    border-color: #61739A;
}
QCheckBox {
    spacing: 8px;
    color: #C7D2E9;
}
QCheckBox::indicator {
    width: 17px;
    height: 17px;
    border-radius: 5px;
    border: 1px solid #53617D;
    background: #0D1628;
}
QCheckBox::indicator:checked {
    background: #633FE2;
    border: 1px solid #9C84FF;
}
QTableWidget {
    background: #0A1220;
    alternate-background-color: #0D1729;
    border: 1px solid #1F2C46;
    border-radius: 10px;
    gridline-color: #1A263D;
    selection-background-color: #31265F;
    selection-color: white;
}
QHeaderView::section {
    background: #101A2D;
    color: #9DABC4;
    border: none;
    border-bottom: 1px solid #253451;
    padding: 8px;
    font-weight: 700;
}
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px;
}
QScrollBar::handle:vertical {
    background: #35435F;
    min-height: 28px;
    border-radius: 5px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
